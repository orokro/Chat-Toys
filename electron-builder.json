{
	"appId": "com.electron.app",
	"directories": {
		"output": "dist"
	},
	"nsis": {
		"oneClick": false,
		"perMachine": false,
		"allowToChangeInstallationDirectory": true,
		"shortcutName": "Chat-Toys"
	},
	"win": {
		"target": [
			{
				"target": "nsis",
				"arch": [
					"x64"
				]
			},
			{
				"target": "msi",
				"arch": [
					"x64"
				]
			}
		]
	},
	"msi": {
		"oneClick": false,
		"perMachine": false,
		"createDesktopShortcut": true,
		"createStartMenuShortcut": true,
		"shortcutName": "Chat-Toys"
	},
	"linux": {
		"target": [
			"snap"
		]
	},
	"files": [
		{
			"from": "build/main",
			"to": "main",
			"filter": [
				"**/*"
			]
		},
		{
			"from": "build/renderer",
			"to": "renderer",
			"filter": [
				"**/*"
			]
		},
		{
			"from": "src/main/static",
			"to": "static",
			"filter": [
				"**/*"
			]
		},
		"!build",
		"!dist",
		"!scripts",
		"!**/*.map",
		"!**/node_modules/.bin",
		"!**/node_modules/**/test{,s}/**",
		"!**/node_modules/**/docs/**",
		"!**/node_modules/**/examples/**",
		"!**/node_modules/**/demo/**",

		"!**/node_modules_backup/.bin",
		"!**/node_modules_backup/**/test{,s}/**",
		"!**/node_modules_backup/**/docs/**",
		"!**/node_modules_backup/**/examples/**",
		"!**/node_modules_backup/**/demo/**",

		"!misc/**",
		"!chat-toys-website/**",
		"!old_vite_cgs/**"
	],
	"extraResources": [
		{
			"from": "src/main/main_assets",
			"to": "main_assets"
		}
	]
}